<?xml version="1.0" encoding="utf-8"?>
<!-- 32-bit (armeabi-v7a) GLES 2.0 NativeActivity (shaders, textured rotating quad) to check the host GLES renderer path (frame
     uploaded with glTexSubImage2D, drawn as one textured quad with glOrthof). Logs FPS to logcat. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.androidware.gles2test" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="24" />
    <uses-feature android:glEsVersion="0x00020000" />
    <application android:label="GLES2 test" android:hasCode="false">
        <activity android:name="android.app.NativeActivity" android:exported="true"
            android:screenOrientation="portrait" android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="gles2test" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
