+/* ------------------------------------------------------------------------ */
+/* goldfish-battery                                                         */
+
+enum {
+    BATTERY_INT_STATUS  = 0x00,
+    BATTERY_INT_ENABLE  = 0x04,
+    BATTERY_AC_ONLINE   = 0x08,
+    BATTERY_STATUS      = 0x0c,
+    BATTERY_HEALTH      = 0x10,
+    BATTERY_PRESENT     = 0x14,
+    BATTERY_CAPACITY    = 0x18,
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishBatteryState, GOLDFISH_BATTERY)
+
+struct GoldfishBatteryState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t int_enable;
+};
+
+static uint64_t goldfish_battery_read(void *opaque, hwaddr offset,
+                                      unsigned size)
+{
+    switch (offset) {
+    case BATTERY_AC_ONLINE:
+        return 1;
+    case BATTERY_STATUS:
+        return 4;   /* POWER_SUPPLY_STATUS_FULL */
+    case BATTERY_HEALTH:
+        return 1;   /* POWER_SUPPLY_HEALTH_GOOD */
+    case BATTERY_PRESENT:
+        return 1;
+    case BATTERY_CAPACITY:
+        return 100;
+    default:
+        return 0;   /* INT_STATUS and newer optional registers */
+    }
+}
+
+static void goldfish_battery_write(void *opaque, hwaddr offset, uint64_t val,
+                                   unsigned size)
+{
+    GoldfishBatteryState *s = opaque;
+    if (offset == BATTERY_INT_ENABLE) {
+        s->int_enable = val;
+    }
+}
+
+static const MemoryRegionOps goldfish_battery_ops = {
+    .read = goldfish_battery_read,
+    .write = goldfish_battery_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void goldfish_battery_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishBatteryState *s = GOLDFISH_BATTERY(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_battery_ops, s,
+                          "goldfish-battery", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+}
+
+static void goldfish_battery_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = goldfish_battery_realize;
+}
+
+/* ------------------------------------------------------------------------ */
+/* goldfish-audio                                                           */
+
+enum {
+    AUDIO_INT_STATUS         = 0x00,
+    AUDIO_INT_ENABLE         = 0x04,
+    AUDIO_SET_WRITE_BUFFER_1 = 0x08,
+    AUDIO_SET_WRITE_BUFFER_2 = 0x0c,
+    AUDIO_WRITE_BUFFER_1     = 0x10,
+    AUDIO_WRITE_BUFFER_2     = 0x14,
+    AUDIO_READ_SUPPORTED     = 0x18,
+};
+#define AUDIO_BUFFER_SIZE   16384
+#define AUDIO_BYTES_PER_SEC (44100 * 2 * 2)
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishAudioState, GOLDFISH_AUDIO)
+
+struct GoldfishAudioState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    CharFrontend chr;
+    QEMUTimer *timer[2];
+    uint32_t int_status, int_enable;
+    uint32_t buf_addr[2];
+    int64_t play_end_ns;        /* guest time at which queued audio ends */
+};
+
+static void goldfish_audio_update_irq(GoldfishAudioState *s)
+{
+    qemu_set_irq(s->irq, (s->int_status & s->int_enable) != 0);
+}
+
+static void goldfish_audio_buffer_empty(GoldfishAudioState *s, int n)
+{
+    s->int_status |= 1u << n;
+    goldfish_audio_update_irq(s);
+}
+
+static void goldfish_audio_timer0(void *opaque)
+{
+    goldfish_audio_buffer_empty(opaque, 0);
+}
+
+static void goldfish_audio_timer1(void *opaque)
+{
+    goldfish_audio_buffer_empty(opaque, 1);
+}
+
+static void goldfish_audio_play(GoldfishAudioState *s, int n, uint32_t len)
+{
+    uint8_t buf[AUDIO_BUFFER_SIZE];
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t start = MAX(now, s->play_end_ns);
+
+    len = MIN(len, AUDIO_BUFFER_SIZE) & ~3u;
+    if (len && qemu_chr_fe_backend_connected(&s->chr)) {
+        address_space_read(&address_space_memory, s->buf_addr[n],
+                           MEMTXATTRS_UNSPECIFIED, buf, len);
+        /* never block the vCPU: drop what the host cannot take, keep frames whole */
+        int done = qemu_chr_fe_write(&s->chr, buf, len);
+        if (done > 0 && (done & 3)) {
+            qemu_chr_fe_write_all(&s->chr, buf + done, 4 - (done & 3));
+        }
+    }
+    s->play_end_ns = start + (int64_t)len * NANOSECONDS_PER_SECOND /
+                     AUDIO_BYTES_PER_SEC;
+    /* this buffer is free again once the audio queued before it has played */
+    timer_mod(s->timer[n], start);
+}
+
+static uint64_t goldfish_audio_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishAudioState *s = opaque;
+    uint32_t ret;
+
+    switch (offset) {
+    case AUDIO_INT_STATUS:
+        ret = s->int_status & s->int_enable;
+        s->int_status &= ~ret;
+        goldfish_audio_update_irq(s);
+        return ret;
+    case AUDIO_READ_SUPPORTED:
+    default:
+        return 0;   /* no recording */
+    }
+}
+
+static void goldfish_audio_write(void *opaque, hwaddr offset, uint64_t val,
+                                 unsigned size)
+{
+    GoldfishAudioState *s = opaque;
+
+    switch (offset) {
+    case AUDIO_INT_ENABLE:
+        s->int_enable = val;
+        goldfish_audio_update_irq(s);
+        break;
+    case AUDIO_SET_WRITE_BUFFER_1:
+        s->buf_addr[0] = val;
+        break;
+    case AUDIO_SET_WRITE_BUFFER_2:
+        s->buf_addr[1] = val;
+        break;
+    case AUDIO_WRITE_BUFFER_1:
+        goldfish_audio_play(s, 0, val);
+        break;
+    case AUDIO_WRITE_BUFFER_2:
+        goldfish_audio_play(s, 1, val);
+        break;
+    default:
+        break;      /* read-buffer and 64-bit address registers: unused */
+    }
+}
+
+static const MemoryRegionOps goldfish_audio_ops = {
+    .read = goldfish_audio_read,
+    .write = goldfish_audio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void goldfish_audio_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishAudioState *s = GOLDFISH_AUDIO(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_audio_ops, s,
+                          "goldfish-audio", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    s->timer[0] = timer_new_ns(QEMU_CLOCK_VIRTUAL, goldfish_audio_timer0, s);
+    s->timer[1] = timer_new_ns(QEMU_CLOCK_VIRTUAL, goldfish_audio_timer1, s);
+}
+
+static void goldfish_audio_reset(DeviceState *dev)
+{
+    GoldfishAudioState *s = GOLDFISH_AUDIO(dev);
+    timer_del(s->timer[0]);
+    timer_del(s->timer[1]);
+    s->int_status = s->int_enable = 0;
+    s->play_end_ns = 0;
+}
+
+static const Property goldfish_audio_properties[] = {
+    DEFINE_PROP_CHR("chardev", GoldfishAudioState, chr),
+};
+
+static void goldfish_audio_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = goldfish_audio_realize;
+    device_class_set_legacy_reset(dc, goldfish_audio_reset);
+    device_class_set_props(dc, goldfish_audio_properties);
+    set_bit(DEVICE_CATEGORY_SOUND, dc->categories);
+}
+
+/* ------------------------------------------------------------------------ */
+/* goldfish-pipe                                                            */
+/*
+ * Guest <-> host byte channels (/dev/qemu_pipe). Only the "opengles" service
+ * is provided: each guest connection becomes one connection to a unix socket
+ * (property "socket") where a GLES render server listens. Everything else
+ * (qemud:* services) is refused, as if the emulator had no such service.
+ */
+
+enum {
+    PIPE_REG_COMMAND      = 0x00,
+    PIPE_REG_STATUS       = 0x04,
+    PIPE_REG_CHANNEL      = 0x08,
+    PIPE_REG_SIZE         = 0x0c,
+    PIPE_REG_ADDRESS      = 0x10,
+    PIPE_REG_WAKES        = 0x14,
+    PIPE_REG_CHANNEL_HIGH = 0x30,
+    PIPE_REG_ADDRESS_HIGH = 0x34,
+};
+enum {
+    PIPE_CMD_OPEN = 1, PIPE_CMD_CLOSE, PIPE_CMD_POLL, PIPE_CMD_WRITE_BUFFER,
+    PIPE_CMD_WAKE_ON_WRITE, PIPE_CMD_READ_BUFFER, PIPE_CMD_WAKE_ON_READ,
+};
+#define PIPE_ERROR_INVAL  (-1)
+#define PIPE_ERROR_AGAIN  (-2)
+#define PIPE_ERROR_IO     (-4)
+#define PIPE_WAKE_CLOSED  (1 << 0)
+#define PIPE_WAKE_READ    (1 << 1)
+#define PIPE_WAKE_WRITE   (1 << 2)
+#define PIPE_POLL_IN      (1 << 0)
+#define PIPE_POLL_OUT     (1 << 1)
+#define PIPE_POLL_HUP     (1 << 2)
+#define PIPE_MAX_XFER     (256 * 1024)
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishPipeState, GOLDFISH_PIPE)
+
+typedef struct GoldfishPipe {
+    GoldfishPipeState *dev;
+    uint64_t channel;
+    int fd;                 /* -1 until the service name has been received */
+    bool closed;            /* closed by the host side */
+    uint32_t wanted;        /* PIPE_WAKE_* the guest asked to be woken for */
+    uint32_t wakes;         /* pending PIPE_WAKE_* to report */
+    bool signalled;         /* queued in dev->signalled */
+    char name[64];
+    unsigned name_len;
+    QTAILQ_ENTRY(GoldfishPipe) next_signalled;
+} GoldfishPipe;
+
+struct GoldfishPipeState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    char *socket_path;
+    GHashTable *pipes;      /* channel -> GoldfishPipe */
+    QTAILQ_HEAD(, GoldfishPipe) signalled;
+    uint64_t channel, address;
+    uint32_t size, status;
+    uint8_t *xfer;
+};
+
+static void goldfish_pipe_update_handlers(GoldfishPipe *p);
+
+static void goldfish_pipe_signal(GoldfishPipe *p, uint32_t wakes)
+{
+    GoldfishPipeState *s = p->dev;
+    p->wakes |= wakes;
+    if (!p->signalled) {
+        p->signalled = true;
+        QTAILQ_INSERT_TAIL(&s->signalled, p, next_signalled);
+    }
+    qemu_set_irq(s->irq, 1);
+}
+
+static void goldfish_pipe_fd_readable(void *opaque)
+{
+    GoldfishPipe *p = opaque;
+    p->wanted &= ~PIPE_WAKE_READ;
+    goldfish_pipe_update_handlers(p);
+    goldfish_pipe_signal(p, PIPE_WAKE_READ);
+}
+
+static void goldfish_pipe_fd_writable(void *opaque)
+{
+    GoldfishPipe *p = opaque;
+    p->wanted &= ~PIPE_WAKE_WRITE;
+    goldfish_pipe_update_handlers(p);
+    goldfish_pipe_signal(p, PIPE_WAKE_WRITE);
+}
+
+static void goldfish_pipe_update_handlers(GoldfishPipe *p)
+{
+    if (p->fd < 0) {
+        return;
+    }
+    qemu_set_fd_handler(p->fd,
+                        (p->wanted & PIPE_WAKE_READ) ? goldfish_pipe_fd_readable : NULL,
+                        (p->wanted & PIPE_WAKE_WRITE) ? goldfish_pipe_fd_writable : NULL,
+                        p);
+}
+
+static void goldfish_pipe_host_close(GoldfishPipe *p)
+{
+    if (p->fd >= 0) {
+        qemu_set_fd_handler(p->fd, NULL, NULL, NULL);
+        close(p->fd);
+        p->fd = -1;
+    }
+    p->closed = true;
+    p->wanted = 0;
+}
+
+static void goldfish_pipe_free(gpointer data)
+{
+    GoldfishPipe *p = data;
+    if (p->signalled) {
+        QTAILQ_REMOVE(&p->dev->signalled, p, next_signalled);
+    }
+    goldfish_pipe_host_close(p);
+    g_free(p);
+}
+
+/* The first bytes written to a new pipe are "pipe:<service>[:<args>]\0" */
+static int32_t goldfish_pipe_connect(GoldfishPipe *p, const uint8_t *buf,
+                                     uint32_t len)
+{
+    GoldfishPipeState *s = p->dev;
+    const uint8_t *nul = memchr(buf, 0, len);
+    uint32_t take = nul ? nul - buf + 1 : len;
+    Error *err = NULL;
+
+    if (p->name_len + take > sizeof(p->name)) {
+        goldfish_pipe_host_close(p);
+        return PIPE_ERROR_INVAL;
+    }
+    memcpy(p->name + p->name_len, buf, take);
+    p->name_len += take;
+    if (!nul) {
+        return take;
+    }
+    if (!g_str_has_prefix(p->name, "pipe:opengles") || !s->socket_path) {
+        goldfish_pipe_host_close(p);
+        return PIPE_ERROR_INVAL;
+    }
+    p->fd = unix_connect(s->socket_path, &err);
+    if (p->fd < 0) {
+        warn_report("goldfish-pipe: cannot reach the GLES renderer: %s",
+                    error_get_pretty(err));
+        error_free(err);
+        goldfish_pipe_host_close(p);
+        return PIPE_ERROR_IO;
+    }
+    g_unix_set_fd_nonblocking(p->fd, true, NULL);
+    return take;
+}
+
+static int32_t goldfish_pipe_xfer(GoldfishPipe *p, bool is_write,
+                                  hwaddr addr, uint32_t len)
+{
+    GoldfishPipeState *s = p->dev;
+    ssize_t n;
+
+    if (p->closed) {
+        return PIPE_ERROR_IO;
+    }
+    len = MIN(len, PIPE_MAX_XFER);
+    if (!len) {
+        return 0;
+    }
+    /*
+     * The 3.10 ranchu driver passes guest *virtual* addresses of the calling
+     * process (one page at a time), so translate through the CPU doing the
+     * access. On failure it touches the page and retries.
+     */
+    if (!current_cpu) {
+        return PIPE_ERROR_INVAL;
+    }
+    len = MIN(len, TARGET_PAGE_SIZE - (addr & (TARGET_PAGE_SIZE - 1)));
+    if (is_write) {
+        if (cpu_memory_rw_debug(current_cpu, addr, s->xfer, len, false) < 0) {
+            return PIPE_ERROR_INVAL;
+        }
+        if (p->fd < 0) {
+            return goldfish_pipe_connect(p, s->xfer, len);
+        }
+        do {
+            n = send(p->fd, s->xfer, len, MSG_DONTWAIT | MSG_NOSIGNAL);
+        } while (n < 0 && errno == EINTR);
+    } else {
+        if (p->fd < 0) {
+            return PIPE_ERROR_INVAL;
+        }
+        /* make sure the page is writable before consuming stream data */
+        if (cpu_memory_rw_debug(current_cpu, addr, s->xfer, 1, false) < 0 ||
+            cpu_memory_rw_debug(current_cpu, addr, s->xfer, 1, true) < 0) {
+            return PIPE_ERROR_INVAL;
+        }
+        do {
+            n = recv(p->fd, s->xfer, len, MSG_DONTWAIT);
+        } while (n < 0 && errno == EINTR);
+        if (n > 0 && cpu_memory_rw_debug(current_cpu, addr, s->xfer, n, true) < 0) {
+            goldfish_pipe_host_close(p);
+            return PIPE_ERROR_IO;
+        }
+    }
+    if (n < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK) {
+            return PIPE_ERROR_AGAIN;
+        }
+        goldfish_pipe_host_close(p);
+        return PIPE_ERROR_IO;
+    }
+    if (n == 0 && !is_write) {
+        goldfish_pipe_host_close(p);    /* renderer went away: EOF */
+    }
+    return n;
+}
+
+static void goldfish_pipe_command(GoldfishPipeState *s, uint32_t cmd)
+{
+    GoldfishPipe *p = g_hash_table_lookup(s->pipes, &s->channel);
+
+    if (cmd == PIPE_CMD_OPEN) {
+        if (p) {
+            s->status = PIPE_ERROR_INVAL;
+            return;
+        }
+        p = g_new0(GoldfishPipe, 1);
+        p->dev = s;
+        p->channel = s->channel;
+        p->fd = -1;
+        g_hash_table_insert(s->pipes, &p->channel, p);
+        s->status = 0;
+        return;
+    }
+    if (!p) {
+        s->status = PIPE_ERROR_INVAL;
+        return;
+    }
+    switch (cmd) {
+    case PIPE_CMD_CLOSE:
+        g_hash_table_remove(s->pipes, &p->channel);
+        break;
+    case PIPE_CMD_POLL: {
+        uint32_t st = 0;
+        if (p->closed) {
+            st = PIPE_POLL_HUP;
+        } else if (p->fd < 0) {
+            st = PIPE_POLL_OUT;
+        } else {
+            struct pollfd pfd = { .fd = p->fd, .events = POLLIN | POLLOUT };
+            if (poll(&pfd, 1, 0) > 0) {
+                st |= (pfd.revents & POLLIN) ? PIPE_POLL_IN : 0;
+                st |= (pfd.revents & POLLOUT) ? PIPE_POLL_OUT : 0;
+                st |= (pfd.revents & (POLLHUP | POLLERR)) ? PIPE_POLL_HUP : 0;
+            }
+        }
+        s->status = st;
+        break;
+    }
+    case PIPE_CMD_WRITE_BUFFER:
+        s->status = goldfish_pipe_xfer(p, true, s->address, s->size);
+        break;
+    case PIPE_CMD_READ_BUFFER:
+        s->status = goldfish_pipe_xfer(p, false, s->address, s->size);
+        break;
+    case PIPE_CMD_WAKE_ON_READ:
+    case PIPE_CMD_WAKE_ON_WRITE:
+        if (p->closed || p->fd < 0) {
+            goldfish_pipe_signal(p, PIPE_WAKE_CLOSED);
+        } else {
+            p->wanted |= cmd == PIPE_CMD_WAKE_ON_READ ? PIPE_WAKE_READ
+                                                      : PIPE_WAKE_WRITE;
+            goldfish_pipe_update_handlers(p);
+        }
+        break;
+    default:
+        s->status = PIPE_ERROR_INVAL;
+    }
+}
+
+static uint64_t goldfish_pipe_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishPipeState *s = opaque;
+    GoldfishPipe *p = QTAILQ_FIRST(&s->signalled);
+
+    switch (offset) {
+    case PIPE_REG_STATUS:
+        return s->status;
+    case PIPE_REG_CHANNEL:
+        /* interrupt handler: next signalled pipe, 0 = none left */
+        if (!p) {
+            qemu_set_irq(s->irq, 0);
+            return 0;
+        }
+        return (uint32_t)p->channel;
+    case PIPE_REG_CHANNEL_HIGH:
+        return p ? p->channel >> 32 : 0;
+    case PIPE_REG_WAKES: {
+        uint32_t wakes = 0;
+        if (p) {
+            wakes = p->wakes;
+            p->wakes = 0;
+            p->signalled = false;
+            QTAILQ_REMOVE(&s->signalled, p, next_signalled);
+        }
+        if (QTAILQ_EMPTY(&s->signalled)) {
+            qemu_set_irq(s->irq, 0);
+        }
+        return wakes;
+    }
+    default:
+        return 0;   /* incl. PARAMS_ADDR: batch access not supported */
+    }
+}
+
+static void goldfish_pipe_write(void *opaque, hwaddr offset, uint64_t val,
+                                unsigned size)
+{
+    GoldfishPipeState *s = opaque;
+
+    switch (offset) {
+    case PIPE_REG_COMMAND:
+        goldfish_pipe_command(s, val);
+        break;
+    case PIPE_REG_CHANNEL:
+        s->channel = deposit64(s->channel, 0, 32, val);
+        break;
+    case PIPE_REG_CHANNEL_HIGH:
+        s->channel = deposit64(s->channel, 32, 32, val);
+        break;
+    case PIPE_REG_SIZE:
+        s->size = val;
+        break;
+    case PIPE_REG_ADDRESS:
+        s->address = deposit64(s->address, 0, 32, val);
+        break;
+    case PIPE_REG_ADDRESS_HIGH:
+        s->address = deposit64(s->address, 32, 32, val);
+        break;
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps goldfish_pipe_ops = {
+    .read = goldfish_pipe_read,
+    .write = goldfish_pipe_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void goldfish_pipe_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishPipeState *s = GOLDFISH_PIPE(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_pipe_ops, s,
+                          "goldfish-pipe", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    s->pipes = g_hash_table_new_full(g_int64_hash, g_int64_equal, NULL,
+                                     goldfish_pipe_free);
+    QTAILQ_INIT(&s->signalled);
+    s->xfer = g_malloc(PIPE_MAX_XFER);
+}
+
+static void goldfish_pipe_reset(DeviceState *dev)
+{
+    GoldfishPipeState *s = GOLDFISH_PIPE(dev);
+    g_hash_table_remove_all(s->pipes);
+    s->channel = s->address = 0;
+    s->size = s->status = 0;
+    qemu_set_irq(s->irq, 0);
+}
+
