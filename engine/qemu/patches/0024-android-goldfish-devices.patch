+/*
+ * Android emulator ("ranchu") guest kernels have no virtio-gpu/virtio-input
+ * drivers; they drive the goldfish framebuffer, event, battery and audio
+ * devices. Audio goes to -global goldfish-audio.chardev=<id> as raw PCM.
+ * Width/height/dpi and the input device name can be changed with
+ * -global goldfish-fb.width=... / -global goldfish-events.name=...
+ */
+static void create_goldfish(const VirtMachineState *vms)
+{
+    static const struct {
+        int idx;
+        const char *type;
+        const char *compat;
+    } devs[] = {
+        { VIRT_GOLDFISH_FB, TYPE_GOLDFISH_FB, "generic,goldfish-fb" },
+        { VIRT_GOLDFISH_EVENTS, TYPE_GOLDFISH_EVENTS,
+          "generic,goldfish-events-keypad" },
+        { VIRT_GOLDFISH_BATTERY, TYPE_GOLDFISH_BATTERY,
+          "generic,goldfish-battery" },
+        { VIRT_GOLDFISH_AUDIO, TYPE_GOLDFISH_AUDIO, "generic,goldfish-audio" },
+    };
+    MachineState *ms = MACHINE(vms);
+
+    for (int i = 0; i < ARRAY_SIZE(devs); i++) {
+        hwaddr base = vms->memmap[devs[i].idx].base;
+        hwaddr size = vms->memmap[devs[i].idx].size;
+        int irq = vms->irqmap[devs[i].idx];
+        DeviceState *dev = qdev_new(devs[i].type);
+        char *nodename;
+
+        if (devs[i].idx == VIRT_GOLDFISH_EVENTS) {
+            g_autofree char *name =
+                object_property_get_str(OBJECT(dev), "name", NULL);
+            if (!name || !*name) {
+                qdev_prop_set_string(dev, "name", "qwerty2");
+            }
+        }
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(dev), 0, base);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           qdev_get_gpio_in(vms->gic, irq));
+
+        nodename = g_strdup_printf("/goldfish@%" PRIx64, base);
+        qemu_fdt_add_subnode(ms->fdt, nodename);
+        qemu_fdt_setprop_string(ms->fdt, nodename, "compatible",
+                                devs[i].compat);
+        qemu_fdt_setprop_sized_cells(ms->fdt, nodename, "reg",
+                                     2, base, 2, size);
+        qemu_fdt_setprop_cells(ms->fdt, nodename, "interrupts",
+                               gic_fdt_irq_type_spi(vms), irq,
+                               GIC_FDT_IRQ_FLAGS_LEVEL_HI);
+        g_free(nodename);
+    }
+}
