+/*
+ * Minimal "goldfish" platform devices for running Android emulator (ranchu)
+ * guest kernels on the upstream 'virt' machine.
+ *
+ *   goldfish-fb       framebuffer (generic,goldfish-fb), scanned out from guest RAM
+ *   goldfish-events   input (generic,goldfish-events-keypad): keys + multi-touch
+ *   goldfish-battery  battery/AC status (generic,goldfish-battery), always full on AC
+ *   goldfish-audio    PCM output (generic,goldfish-audio): 44.1 kHz stereo s16le, written
+ *                     raw to a chardev (the host app plays it); paced in guest time
+ *
+ * The register interfaces follow the guest drivers in the Android goldfish
+ * kernels (drivers/video/goldfishfb.c, drivers/input/keyboard/goldfish_events.c,
+ * drivers/power/goldfish_battery.c, drivers/staging/goldfish/goldfish_audio.c).
+ * Written for androidware.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "system/address-spaces.h"
+#include "ui/console.h"
+#include "qemu/timer.h"
+#include "chardev/char-fe.h"
+#include "hw/core/qdev-properties-system.h"
+#include "ui/input.h"
+#include "ui/pixel_ops.h"
+#include "standard-headers/linux/input.h"
+#include "hw/display/framebuffer.h"
+#include "qom/object.h"
+#include "hw/arm/android-goldfish.h"
+
+/* ------------------------------------------------------------------------ */
+/* goldfish-fb                                                              */
+
+enum {
+    FB_GET_WIDTH        = 0x00,
+    FB_GET_HEIGHT       = 0x04,
+    FB_INT_STATUS       = 0x08,
+    FB_INT_ENABLE       = 0x0c,
+    FB_SET_BASE         = 0x10,
+    FB_SET_ROTATION     = 0x14,
+    FB_SET_BLANK        = 0x18,
+    FB_GET_PHYS_WIDTH   = 0x1c,
+    FB_GET_PHYS_HEIGHT  = 0x20,
+    FB_GET_FORMAT       = 0x24,
+};
+#define FB_INT_VSYNC            (1u << 0)
+#define FB_INT_BASE_UPDATE_DONE (1u << 1)
+#define HAL_PIXEL_FORMAT_RGB_565 4
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishFBState, GOLDFISH_FB)
+
+struct GoldfishFBState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QemuConsole *con;
+    MemoryRegionSection fbsection;
+    uint32_t width, height, dpi;
+    uint32_t int_status, int_enable;
+    uint32_t base, blank, rotation;
+    bool invalidate;
+};
+
+static void goldfish_fb_update_irq(GoldfishFBState *s)
+{
+    qemu_set_irq(s->irq, (s->int_status & s->int_enable) != 0);
+}
+
+static void goldfish_fb_draw_line(void *opaque, uint8_t *d, const uint8_t *s,
+                                  int width, int deststep)
+{
+    uint32_t *dst = (uint32_t *)d;
+    while (width--) {
+        uint16_t v = lduw_le_p(s);
+        unsigned r = (v >> 11) & 0x1f, g = (v >> 5) & 0x3f, b = v & 0x1f;
+        *dst++ = rgb_to_pixel32((r << 3) | (r >> 2), (g << 2) | (g >> 4),
+                                (b << 3) | (b >> 2));
+        s += 2;
+    }
+}
+
+static bool goldfish_fb_update_display(void *opaque)
+{
+    GoldfishFBState *s = opaque;
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    int first = 0, last = 0;
+    int src_width = s->width * 2;
+
+    /* vsync for guests that enable it */
+    if (s->int_enable & FB_INT_VSYNC) {
+        s->int_status |= FB_INT_VSYNC;
+        goldfish_fb_update_irq(s);
+    }
+    if (!s->base || !surface) {
+        return true;
+    }
+    if (surface_width(surface) != s->width ||
+        surface_height(surface) != s->height) {
+        qemu_console_resize(s->con, s->width, s->height);
+        surface = qemu_console_surface(s->con);
+        s->invalidate = true;
+    }
+    if (s->blank) {
+        return true;
+    }
+    if (s->invalidate) {
+        framebuffer_update_memory_section(&s->fbsection, get_system_memory(),
+                                          s->base, s->height, src_width);
+    }
+    first = 0;   /* in: first row to draw; out: first row drawn, or -1 */
+    framebuffer_update_display(surface, &s->fbsection, s->width, s->height,
+                               src_width, surface_stride(surface), 0,
+                               s->invalidate, goldfish_fb_draw_line, s,
+                               &first, &last);
+    if (first >= 0) {
+        qemu_console_update(s->con, 0, first, s->width, last - first + 1);
+    }
+    s->invalidate = false;
+    return true;
+}
+
+static void goldfish_fb_invalidate(void *opaque)
+{
+    GoldfishFBState *s = opaque;
+    s->invalidate = true;
+}
+
+static uint64_t goldfish_fb_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishFBState *s = opaque;
+    uint32_t ret;
+
+    switch (offset) {
+    case FB_GET_WIDTH:
+        return s->width;
+    case FB_GET_HEIGHT:
+        return s->height;
+    case FB_INT_STATUS:
+        ret = s->int_status & s->int_enable;
+        s->int_status &= ~ret;
+        goldfish_fb_update_irq(s);
+        return ret;
+    case FB_GET_PHYS_WIDTH:     /* millimetres */
+        return s->width * 254 / (s->dpi * 10);
+    case FB_GET_PHYS_HEIGHT:
+        return s->height * 254 / (s->dpi * 10);
+    case FB_GET_FORMAT:
+        return HAL_PIXEL_FORMAT_RGB_565;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "goldfish-fb: bad read 0x%" HWADDR_PRIx
+                      "\n", offset);
+        return 0;
+    }
+}
+
+static void goldfish_fb_write(void *opaque, hwaddr offset, uint64_t val,
+                              unsigned size)
+{
+    GoldfishFBState *s = opaque;
+
+    switch (offset) {
+    case FB_INT_ENABLE:
+        s->int_enable = val;
+        goldfish_fb_update_irq(s);
+        break;
+    case FB_SET_BASE:
+        s->base = val;
+        s->invalidate = true;
+        /* the new buffer is shown from the next refresh on */
+        s->int_status |= FB_INT_BASE_UPDATE_DONE;
+        goldfish_fb_update_irq(s);
+        break;
+    case FB_SET_ROTATION:
+        s->rotation = val;
+        break;
+    case FB_SET_BLANK:
+        s->blank = val;
+        s->invalidate = true;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "goldfish-fb: bad write 0x%" HWADDR_PRIx
+                      "\n", offset);
+    }
+}
+
+static const MemoryRegionOps goldfish_fb_ops = {
+    .read = goldfish_fb_read,
+    .write = goldfish_fb_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static const GraphicHwOps goldfish_fb_gfx_ops = {
+    .invalidate = goldfish_fb_invalidate,
+    .gfx_update = goldfish_fb_update_display,
+};
+
+static void goldfish_fb_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishFBState *s = GOLDFISH_FB(dev);
+
+    if (!s->width || !s->height || !s->dpi) {
+        error_setg(errp, "goldfish-fb: width, height and dpi must be non-zero");
+        return;
+    }
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_fb_ops, s,
+                          "goldfish-fb", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    s->con = qemu_graphic_console_create(dev, 0, &goldfish_fb_gfx_ops, s);
+    qemu_console_resize(s->con, s->width, s->height);
+}
+
+static void goldfish_fb_reset(DeviceState *dev)
+{
+    GoldfishFBState *s = GOLDFISH_FB(dev);
+    s->int_status = s->int_enable = 0;
+    s->base = s->blank = s->rotation = 0;
+    s->invalidate = true;
+}
+
+static int goldfish_fb_post_load(void *opaque, int version_id)
+{
+    goldfish_fb_invalidate(opaque);
+    return 0;
+}
+
+static const VMStateDescription vmstate_goldfish_fb = {
+    .name = "goldfish-fb",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = goldfish_fb_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(int_status, GoldfishFBState),
+        VMSTATE_UINT32(int_enable, GoldfishFBState),
+        VMSTATE_UINT32(base, GoldfishFBState),
+        VMSTATE_UINT32(blank, GoldfishFBState),
+        VMSTATE_UINT32(rotation, GoldfishFBState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static const Property goldfish_fb_properties[] = {
+    DEFINE_PROP_UINT32("width", GoldfishFBState, width, 480),
+    DEFINE_PROP_UINT32("height", GoldfishFBState, height, 800),
+    DEFINE_PROP_UINT32("dpi", GoldfishFBState, dpi, 240),
+};
+
+static void goldfish_fb_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = goldfish_fb_realize;
+    device_class_set_legacy_reset(dc, goldfish_fb_reset);
+    dc->vmsd = &vmstate_goldfish_fb;
+    device_class_set_props(dc, goldfish_fb_properties);
+    set_bit(DEVICE_CATEGORY_DISPLAY, dc->categories);
+}
+
+/* ------------------------------------------------------------------------ */
+/* goldfish-events                                                          */
+
+enum {
+    EV_REG_READ     = 0x00,
+    EV_REG_SET_PAGE = 0x00,
+    EV_REG_LEN      = 0x04,
+    EV_REG_DATA     = 0x08,
+};
+#define EV_PAGE_NAME    0x00000
+#define EV_PAGE_EVBITS  0x10000
+#define EV_PAGE_ABSDATA (0x20000 | EV_ABS)
+
+#define GF_EV_QUEUE     1024          /* in events (type, code, value) */
+#define GF_EV_SLOTS     10
+#define GF_EV_ABS_MAX   0x7fff        /* same range as QEMU's absolute axes */
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishEventsState, GOLDFISH_EVENTS)
+
+struct GoldfishEventsState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QemuInputHandlerState *hs;
+    char *name;
+    uint32_t page;
+    /* queue of u32 words; three words per event */
+    uint32_t q[GF_EV_QUEUE * 3];
+    uint32_t q_head, q_count;
+    /* single-pointer -> touch emulation state */
+    int32_t ptr_x, ptr_y;
+    bool ptr_down, ptr_dirty, ptr_was_down;
+    int32_t next_tracking_id;
+    /* multi-touch: last slot sent */
+    int32_t cur_slot;
+};
+
+static void goldfish_events_update_irq(GoldfishEventsState *s)
+{
+    qemu_set_irq(s->irq, s->q_count != 0);
+}
+
+static void goldfish_events_put(GoldfishEventsState *s, uint32_t type,
+                                uint32_t code, int32_t value)
+{
+    uint32_t cap = ARRAY_SIZE(s->q);
+    if (s->q_count + 3 > cap) {
+        qemu_log_mask(LOG_UNIMP, "goldfish-events: queue full, event dropped\n");
+        return;
+    }
+    s->q[(s->q_head + s->q_count++) % cap] = type;
+    s->q[(s->q_head + s->q_count++) % cap] = code;
+    s->q[(s->q_head + s->q_count++) % cap] = (uint32_t)value;
+    goldfish_events_update_irq(s);
+}
+
+static void gf_set_bit(uint8_t *bits, unsigned bit)
+{
+    bits[bit / 8] |= 1u << (bit % 8);
+}
+
+/* Fill the page selected by s->page; returns its length */
+static unsigned goldfish_events_page(GoldfishEventsState *s, uint8_t *buf,
+                                     unsigned bufsize)
+{
+    unsigned len = 0;
+
+    memset(buf, 0, bufsize);
+    if (s->page == EV_PAGE_NAME) {
+        len = MIN(strlen(s->name), bufsize);
+        memcpy(buf, s->name, len);
+    } else if (s->page == EV_PAGE_ABSDATA) {
+        static const struct { unsigned code; int32_t min, max; } abs[] = {
+            { ABS_X, 0, GF_EV_ABS_MAX },
+            { ABS_Y, 0, GF_EV_ABS_MAX },
+            { ABS_MT_SLOT, 0, GF_EV_SLOTS - 1 },
+            { ABS_MT_TOUCH_MAJOR, 0, 0x7f },
+            { ABS_MT_POSITION_X, 0, GF_EV_ABS_MAX },
+            { ABS_MT_POSITION_Y, 0, GF_EV_ABS_MAX },
+            { ABS_MT_TRACKING_ID, 0, 0xffff },
+            { ABS_MT_PRESSURE, 0, 0xff },
+        };
+        uint32_t *w = (uint32_t *)buf;
+        len = (ABS_MT_PRESSURE + 1) * 16;
+        assert(len <= bufsize);
+        for (int i = 0; i < ARRAY_SIZE(abs); i++) {
+            stl_le_p(&w[abs[i].code * 4 + 0], abs[i].min);
+            stl_le_p(&w[abs[i].code * 4 + 1], abs[i].max);
+        }
+    } else if ((s->page & ~0xffffu) == EV_PAGE_EVBITS) {
+        unsigned type = s->page & 0xffff;
+        switch (type) {
+        case EV_SYN:
+            gf_set_bit(buf, EV_SYN);
+            gf_set_bit(buf, EV_KEY);
+            gf_set_bit(buf, EV_ABS);
+            len = 1;
+            break;
+        case EV_KEY:
+            /* all keyboard keys QEMU can produce, plus BTN_TOUCH */
+            for (unsigned i = 0; i < qemu_input_map_qcode_to_linux_len; i++) {
+                unsigned k = qemu_input_map_qcode_to_linux[i];
+                if (k && k < 0x200) {
+                    gf_set_bit(buf, k);
+                }
+            }
+            gf_set_bit(buf, KEY_BACK);
+            gf_set_bit(buf, KEY_HOMEPAGE);
+            gf_set_bit(buf, KEY_MENU);
+            gf_set_bit(buf, KEY_SEARCH);
+            gf_set_bit(buf, BTN_TOUCH);
+            len = 0x200 / 8;
+            break;
+        case EV_ABS:
+            gf_set_bit(buf, ABS_X);
+            gf_set_bit(buf, ABS_Y);
+            gf_set_bit(buf, ABS_MT_SLOT);
+            gf_set_bit(buf, ABS_MT_TOUCH_MAJOR);
+            gf_set_bit(buf, ABS_MT_POSITION_X);
+            gf_set_bit(buf, ABS_MT_POSITION_Y);
+            gf_set_bit(buf, ABS_MT_TRACKING_ID);
+            gf_set_bit(buf, ABS_MT_PRESSURE);
+            len = (ABS_MT_PRESSURE + 8) / 8;
+            break;
+        default:
+            len = 0;
+        }
+    }
+    return len;
+}
+
+static uint64_t goldfish_events_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishEventsState *s = opaque;
+    uint8_t buf[0x400];
+    unsigned len;
+
+    if (offset == EV_REG_READ && size == 4) {
+        uint32_t v = 0;
+        if (s->q_count) {
+            v = s->q[s->q_head];
+            s->q_head = (s->q_head + 1) % ARRAY_SIZE(s->q);
+            s->q_count--;
+            goldfish_events_update_irq(s);
+        }
+        return v;
+    }
+    len = goldfish_events_page(s, buf, sizeof(buf));
+    if (offset == EV_REG_LEN) {
+        return len;
+    }
+    if (offset >= EV_REG_DATA && offset - EV_REG_DATA + size <= sizeof(buf)) {
+        return ldn_le_p(buf + offset - EV_REG_DATA, size);
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "goldfish-events: bad read 0x%" HWADDR_PRIx
+                  "\n", offset);
+    return 0;
+}
+
+static void goldfish_events_write(void *opaque, hwaddr offset, uint64_t val,
+                                  unsigned size)
+{
+    GoldfishEventsState *s = opaque;
+
+    if (offset == EV_REG_SET_PAGE) {
+        s->page = val;
+    } else {
+        qemu_log_mask(LOG_GUEST_ERROR, "goldfish-events: bad write 0x%"
+                      HWADDR_PRIx "\n", offset);
+    }
+}
+
+static const MemoryRegionOps goldfish_events_ops = {
+    .read = goldfish_events_read,
+    .write = goldfish_events_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void goldfish_events_mt_slot(GoldfishEventsState *s, int slot)
+{
+    if (s->cur_slot != slot) {
+        goldfish_events_put(s, EV_ABS, ABS_MT_SLOT, slot);
+        s->cur_slot = slot;
+    }
+}
+
+static void goldfish_events_handle(DeviceState *dev, QemuConsole *src,
+                                   QemuInputEvent *evt)
+{
+    GoldfishEventsState *s = GOLDFISH_EVENTS(dev);
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_KEY:
+        if (evt->key.key) {
+            goldfish_events_put(s, EV_KEY, evt->key.key, evt->key.down);
+        }
+        break;
+    case INPUT_EVENT_KIND_BTN:
+        /* the (single) pointer acts as finger 0 */
+        if (evt->btn.button == INPUT_BUTTON_LEFT) {
+            s->ptr_down = evt->btn.down;
+            s->ptr_dirty = true;
+        }
+        break;
+    case INPUT_EVENT_KIND_ABS:
+        if (evt->abs.axis == INPUT_AXIS_X) {
+            s->ptr_x = evt->abs.value;
+        } else if (evt->abs.axis == INPUT_AXIS_Y) {
+            s->ptr_y = evt->abs.value;
+        }
+        s->ptr_dirty = true;
+        break;
+    case INPUT_EVENT_KIND_MTT:
+        if (evt->mtt.slot >= GF_EV_SLOTS) {
+            break;
+        }
+        switch (evt->mtt.type) {
+        case INPUT_MULTI_TOUCH_TYPE_BEGIN:
+            goldfish_events_mt_slot(s, evt->mtt.slot);
+            goldfish_events_put(s, EV_ABS, ABS_MT_TRACKING_ID,
+                                evt->mtt.tracking_id & 0xffff);
+            goldfish_events_put(s, EV_ABS, ABS_MT_PRESSURE, 0x80);
+            goldfish_events_put(s, EV_ABS, ABS_MT_TOUCH_MAJOR, 0x10);
+            break;
+        case INPUT_MULTI_TOUCH_TYPE_UPDATE:
+        case INPUT_MULTI_TOUCH_TYPE_DATA:
+            goldfish_events_mt_slot(s, evt->mtt.slot);
+            if (evt->mtt.axis == INPUT_AXIS_X) {
+                goldfish_events_put(s, EV_ABS, ABS_MT_POSITION_X,
+                                    evt->mtt.value);
+            } else if (evt->mtt.axis == INPUT_AXIS_Y) {
+                goldfish_events_put(s, EV_ABS, ABS_MT_POSITION_Y,
+                                    evt->mtt.value);
+            }
+            break;
+        case INPUT_MULTI_TOUCH_TYPE_END:
+        case INPUT_MULTI_TOUCH_TYPE_CANCEL:
+            goldfish_events_mt_slot(s, evt->mtt.slot);
+            goldfish_events_put(s, EV_ABS, ABS_MT_TRACKING_ID, -1);
+            break;
+        default:
+            break;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void goldfish_events_sync(DeviceState *dev)
+{
+    GoldfishEventsState *s = GOLDFISH_EVENTS(dev);
+
+    if (s->ptr_dirty) {
+        goldfish_events_mt_slot(s, 0);
+        if (s->ptr_down && !s->ptr_was_down) {
+            goldfish_events_put(s, EV_ABS, ABS_MT_TRACKING_ID,
+                                s->next_tracking_id++ & 0xffff);
+            goldfish_events_put(s, EV_ABS, ABS_MT_PRESSURE, 0x80);
+            goldfish_events_put(s, EV_ABS, ABS_MT_TOUCH_MAJOR, 0x10);
+        }
+        if (s->ptr_down) {
+            goldfish_events_put(s, EV_ABS, ABS_MT_POSITION_X, s->ptr_x);
+            goldfish_events_put(s, EV_ABS, ABS_MT_POSITION_Y, s->ptr_y);
+        }
+        /*
+         * The guest driver issues input_sync() after every EV_KEY, so
+         * BTN_TOUCH must come after the coordinates of the new contact.
+         */
+        if (s->ptr_down && !s->ptr_was_down) {
+            goldfish_events_put(s, EV_KEY, BTN_TOUCH, 1);
+        }
+        if (!s->ptr_down && s->ptr_was_down) {
+            goldfish_events_put(s, EV_ABS, ABS_MT_TRACKING_ID, -1);
+            goldfish_events_put(s, EV_KEY, BTN_TOUCH, 0);
+        }
+        s->ptr_was_down = s->ptr_down;
+        s->ptr_dirty = false;
+    }
+    goldfish_events_put(s, EV_SYN, SYN_REPORT, 0);
+}
+
+static const QemuInputHandler goldfish_events_handler = {
+    .name  = "goldfish-events",
+    .mask  = INPUT_EVENT_MASK_KEY | INPUT_EVENT_MASK_BTN |
+             INPUT_EVENT_MASK_ABS | INPUT_EVENT_MASK_MTT,
+    .event = goldfish_events_handle,
+    .sync  = goldfish_events_sync,
+};
+
+static void goldfish_events_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishEventsState *s = GOLDFISH_EVENTS(dev);
+
+    if (!s->name || !*s->name) {
+        error_setg(errp, "goldfish-events: 'name' must be set");
+        return;
+    }
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_events_ops, s,
+                          "goldfish-events", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    s->hs = qemu_input_handler_register(dev, &goldfish_events_handler);
+    qemu_input_handler_activate(s->hs);
+}
+
+static void goldfish_events_reset(DeviceState *dev)
+{
+    GoldfishEventsState *s = GOLDFISH_EVENTS(dev);
+    s->page = 0;
+    s->q_head = s->q_count = 0;
+    s->cur_slot = 0;
+    s->ptr_down = s->ptr_dirty = s->ptr_was_down = false;
+}
+
+static const Property goldfish_events_properties[] = {
+    /* "qwerty2" picks up the emulator's qwerty2.idc (touchscreen) + qwerty.kl */
+    DEFINE_PROP_STRING("name", GoldfishEventsState, name),
+};
+
+static void goldfish_events_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = goldfish_events_realize;
+    device_class_set_legacy_reset(dc, goldfish_events_reset);
+    device_class_set_props(dc, goldfish_events_properties);
+    set_bit(DEVICE_CATEGORY_INPUT, dc->categories);
+}
+
+/* ------------------------------------------------------------------------ */
+/* goldfish-battery                                                         */
+
+enum {
+    BATTERY_INT_STATUS  = 0x00,
+    BATTERY_INT_ENABLE  = 0x04,
+    BATTERY_AC_ONLINE   = 0x08,
+    BATTERY_STATUS      = 0x0c,
+    BATTERY_HEALTH      = 0x10,
+    BATTERY_PRESENT     = 0x14,
+    BATTERY_CAPACITY    = 0x18,
+};
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishBatteryState, GOLDFISH_BATTERY)
+
+struct GoldfishBatteryState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t int_enable;
+};
+
+static uint64_t goldfish_battery_read(void *opaque, hwaddr offset,
+                                      unsigned size)
+{
+    switch (offset) {
+    case BATTERY_AC_ONLINE:
+        return 1;
+    case BATTERY_STATUS:
+        return 4;   /* POWER_SUPPLY_STATUS_FULL */
+    case BATTERY_HEALTH:
+        return 1;   /* POWER_SUPPLY_HEALTH_GOOD */
+    case BATTERY_PRESENT:
+        return 1;
+    case BATTERY_CAPACITY:
+        return 100;
+    default:
+        return 0;   /* INT_STATUS and newer optional registers */
+    }
+}
+
+static void goldfish_battery_write(void *opaque, hwaddr offset, uint64_t val,
+                                   unsigned size)
+{
+    GoldfishBatteryState *s = opaque;
+    if (offset == BATTERY_INT_ENABLE) {
+        s->int_enable = val;
+    }
+}
+
+static const MemoryRegionOps goldfish_battery_ops = {
+    .read = goldfish_battery_read,
+    .write = goldfish_battery_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void goldfish_battery_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishBatteryState *s = GOLDFISH_BATTERY(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_battery_ops, s,
+                          "goldfish-battery", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+}
+
+static void goldfish_battery_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = goldfish_battery_realize;
+}
+
+/* ------------------------------------------------------------------------ */
+/* goldfish-audio                                                           */
+
+enum {
+    AUDIO_INT_STATUS         = 0x00,
+    AUDIO_INT_ENABLE         = 0x04,
+    AUDIO_SET_WRITE_BUFFER_1 = 0x08,
+    AUDIO_SET_WRITE_BUFFER_2 = 0x0c,
+    AUDIO_WRITE_BUFFER_1     = 0x10,
+    AUDIO_WRITE_BUFFER_2     = 0x14,
+    AUDIO_READ_SUPPORTED     = 0x18,
+};
+#define AUDIO_BUFFER_SIZE   16384
+#define AUDIO_BYTES_PER_SEC (44100 * 2 * 2)
+
+OBJECT_DECLARE_SIMPLE_TYPE(GoldfishAudioState, GOLDFISH_AUDIO)
+
+struct GoldfishAudioState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    CharFrontend chr;
+    QEMUTimer *timer[2];
+    uint32_t int_status, int_enable;
+    uint32_t buf_addr[2];
+    int64_t play_end_ns;        /* guest time at which queued audio ends */
+};
+
+static void goldfish_audio_update_irq(GoldfishAudioState *s)
+{
+    qemu_set_irq(s->irq, (s->int_status & s->int_enable) != 0);
+}
+
+static void goldfish_audio_buffer_empty(GoldfishAudioState *s, int n)
+{
+    s->int_status |= 1u << n;
+    goldfish_audio_update_irq(s);
+}
+
+static void goldfish_audio_timer0(void *opaque)
+{
+    goldfish_audio_buffer_empty(opaque, 0);
+}
+
+static void goldfish_audio_timer1(void *opaque)
+{
+    goldfish_audio_buffer_empty(opaque, 1);
+}
+
+static void goldfish_audio_play(GoldfishAudioState *s, int n, uint32_t len)
+{
+    uint8_t buf[AUDIO_BUFFER_SIZE];
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t start = MAX(now, s->play_end_ns);
+
+    len = MIN(len, AUDIO_BUFFER_SIZE) & ~3u;
+    if (len && qemu_chr_fe_backend_connected(&s->chr)) {
+        address_space_read(&address_space_memory, s->buf_addr[n],
+                           MEMTXATTRS_UNSPECIFIED, buf, len);
+        /* never block the vCPU: drop what the host cannot take, keep frames whole */
+        int done = qemu_chr_fe_write(&s->chr, buf, len);
+        if (done > 0 && (done & 3)) {
+            qemu_chr_fe_write_all(&s->chr, buf + done, 4 - (done & 3));
+        }
+    }
+    s->play_end_ns = start + (int64_t)len * NANOSECONDS_PER_SECOND /
+                     AUDIO_BYTES_PER_SEC;
+    /* this buffer is free again once the audio queued before it has played */
+    timer_mod(s->timer[n], start);
+}
+
+static uint64_t goldfish_audio_read(void *opaque, hwaddr offset, unsigned size)
+{
+    GoldfishAudioState *s = opaque;
+    uint32_t ret;
+
+    switch (offset) {
+    case AUDIO_INT_STATUS:
+        ret = s->int_status & s->int_enable;
+        s->int_status &= ~ret;
+        goldfish_audio_update_irq(s);
+        return ret;
+    case AUDIO_READ_SUPPORTED:
+    default:
+        return 0;   /* no recording */
+    }
+}
+
+static void goldfish_audio_write(void *opaque, hwaddr offset, uint64_t val,
+                                 unsigned size)
+{
+    GoldfishAudioState *s = opaque;
+
+    switch (offset) {
+    case AUDIO_INT_ENABLE:
+        s->int_enable = val;
+        goldfish_audio_update_irq(s);
+        break;
+    case AUDIO_SET_WRITE_BUFFER_1:
+        s->buf_addr[0] = val;
+        break;
+    case AUDIO_SET_WRITE_BUFFER_2:
+        s->buf_addr[1] = val;
+        break;
+    case AUDIO_WRITE_BUFFER_1:
+        goldfish_audio_play(s, 0, val);
+        break;
+    case AUDIO_WRITE_BUFFER_2:
+        goldfish_audio_play(s, 1, val);
+        break;
+    default:
+        break;      /* read-buffer and 64-bit address registers: unused */
+    }
+}
+
+static const MemoryRegionOps goldfish_audio_ops = {
+    .read = goldfish_audio_read,
+    .write = goldfish_audio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void goldfish_audio_realize(DeviceState *dev, Error **errp)
+{
+    GoldfishAudioState *s = GOLDFISH_AUDIO(dev);
+    memory_region_init_io(&s->iomem, OBJECT(s), &goldfish_audio_ops, s,
+                          "goldfish-audio", 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(dev), &s->irq);
+    s->timer[0] = timer_new_ns(QEMU_CLOCK_VIRTUAL, goldfish_audio_timer0, s);
+    s->timer[1] = timer_new_ns(QEMU_CLOCK_VIRTUAL, goldfish_audio_timer1, s);
+}
+
+static void goldfish_audio_reset(DeviceState *dev)
+{
+    GoldfishAudioState *s = GOLDFISH_AUDIO(dev);
+    timer_del(s->timer[0]);
+    timer_del(s->timer[1]);
+    s->int_status = s->int_enable = 0;
+    s->play_end_ns = 0;
+}
+
+static const Property goldfish_audio_properties[] = {
+    DEFINE_PROP_CHR("chardev", GoldfishAudioState, chr),
+};
+
+static void goldfish_audio_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = goldfish_audio_realize;
+    device_class_set_legacy_reset(dc, goldfish_audio_reset);
+    device_class_set_props(dc, goldfish_audio_properties);
+    set_bit(DEVICE_CATEGORY_SOUND, dc->categories);
+}
+
+static const TypeInfo android_goldfish_types[] = {
+    {
+        .name = TYPE_GOLDFISH_FB,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(GoldfishFBState),
+        .class_init = goldfish_fb_class_init,
+    }, {
+        .name = TYPE_GOLDFISH_EVENTS,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(GoldfishEventsState),
+        .class_init = goldfish_events_class_init,
+    }, {
+        .name = TYPE_GOLDFISH_BATTERY,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(GoldfishBatteryState),
+        .class_init = goldfish_battery_class_init,
+    }, {
+        .name = TYPE_GOLDFISH_AUDIO,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(GoldfishAudioState),
+        .class_init = goldfish_audio_class_init,
+    },
+};
+
+DEFINE_TYPES(android_goldfish_types)
