+bool tlb_context_check_tag(CPUState *cpu, uint64_t tag)
+{
+    struct CPUTLBContexts *ctx = cpu->tlb_ctx;
+
+    assert_cpu_is_self(cpu);
+
+    if (!ctx || ctx->live_tag == tag) {
+        return true;
+    }
+    if (ctx->live_tag == 0) {
+        ctx->live_tag = tag;
+        return true;
+    }
+    qatomic_set(&ctx->n_tag_mismatch, ctx->n_tag_mismatch + 1);
+    tlb_flush_live(cpu, ALL_MMUIDX_BITS, true, -1);
+    ctx->live_tag = tag;
+    return false;
+}
