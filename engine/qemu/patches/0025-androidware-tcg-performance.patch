+/*
+ * androidware: saved address-space contexts, see exec/cputlb.h.
+ *
+ * Each vCPU owns TLB_CTX_SLOTS + 1 sets of (TLB tables, jump cache). One set
+ * is live, i.e. its descriptors are in cpu->neg.tlb and its jump cache is
+ * cpu->tb_jmp_cache; the others are parked in slots, tagged with the id of
+ * the address space they belong to. Only the vCPU thread changes the slots,
+ * under tlb_c.lock (tlb_reset_dirty() of another thread reads them under the
+ * same lock). The jump caches are also cleared by other threads when a TB is
+ * invalidated; jc[] never changes after creation, and jc_used[] is only
+ * written by the vCPU thread.
+ */
+#define TLB_CTX_SLOTS 16
+
+typedef struct TLBCtxSlot {
+    bool valid;
+    uint32_t id;
+    uint64_t last_use;
+    MMUIdxMap dirty;
