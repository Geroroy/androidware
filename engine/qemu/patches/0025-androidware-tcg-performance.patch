+void tlb_visit_entries(CPUState *cpu, tlb_entry_visitor *fn, void *opaque)
+{
+    assert_cpu_is_self(cpu);
+
+    for (int mmu_idx = 0; mmu_idx < NB_MMU_MODES; mmu_idx++) {
+        CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
+        CPUTLBDescFast *fast = cpu_tlb_fast(cpu, mmu_idx);
+        size_t n = tlb_n_entries(fast);
+
+        if (!((cpu->neg.tlb.c.dirty >> mmu_idx) & 1)) {
+            continue;
+        }
+        for (size_t i = 0; i < n + CPU_VTLB_SIZE; i++) {
+            CPUTLBEntry *e = i < n ? &fast->table[i] : &desc->vtable[i - n];
+            CPUTLBEntryFull *full = i < n ? &desc->fulltlb[i] : &desc->vfulltlb[i - n];
+            bool r = !(e->addr_read & TLB_INVALID_MASK) && e->addr_read != -1;
+            bool w = !(e->addr_write & TLB_INVALID_MASK) && e->addr_write != -1;
+            bool x = !(e->addr_code & TLB_INVALID_MASK) && e->addr_code != -1;
+            vaddr page;
+
+            if (!r && !w && !x) {
+                continue;
+            }
+            page = (r ? e->addr_read : w ? e->addr_write : e->addr_code) & TARGET_PAGE_MASK;
+            fn(cpu, mmu_idx, page, r, w, x, full->phys_addr & TARGET_PAGE_MASK, opaque);
+        }
+    }
+}
