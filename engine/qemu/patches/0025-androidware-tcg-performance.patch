+void tlb_switch_context(CPUState *cpu, uint32_t old_id, uint32_t new_id)
+{
+    struct CPUTLBContexts *ctx;
+    CPUTLB *tlb = &cpu->neg.tlb;
+    TLBCtxSlot *target = NULL, *victim = NULL;
+    MMUIdxMap work;
+    int64_t now;
+    int j;
+
+    assert_cpu_is_self(cpu);
+
+    if (old_id == new_id) {
+        return;
+    }
+    if (!tlb_ctx_enabled() || !cpu->tb_jmp_cache) {
+        tlb_flush(cpu);
+        return;
+    }
+    ctx = tlb_ctx_get(cpu);
+    now = get_clock_realtime();
+
+    qemu_spin_lock(&tlb->c.lock);
+
+    /*
+     * The tables are only resized when they are flushed. Without the flush
+     * on every switch that would never happen, so do it here for a table
+     * that has become too full; this loses its entries once per doubling.
+     */
+    for (work = tlb->c.dirty; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDesc *desc = &tlb->d[mmu_idx];
+        size_t n = tlb_n_entries(cpu_tlb_fast(cpu, mmu_idx));
+
+        if (desc->n_used_entries * 100 / n > 70 && n < (1 << CPU_TLB_DYN_MAX_BITS)) {
+            tlb_flush_one_mmuidx_locked(cpu, mmu_idx, now);
+            tlb->c.dirty &= ~(1u << mmu_idx);
+        }
+    }
+
+    for (int s = 0; s < TLB_CTX_SLOTS; s++) {
+        TLBCtxSlot *slot = &ctx->slot[s];
+
+        if (!slot->valid) {
+            if (!victim || victim->valid) {
+                victim = slot;
+            }
+        } else if (slot->id == new_id && !target) {
+            target = slot;
+        } else if (slot->id == old_id || slot->id == new_id) {
+            /* cannot happen; never keep two contexts with one id */
+            slot->valid = false;
+            qatomic_set(&ctx->jc_used[slot->jc], false);
+            victim = slot;
+        } else if (!victim || (victim->valid && slot->last_use < victim->last_use)) {
+            victim = slot;
+        }
+    }
+
+    qatomic_set(&ctx->n_switch, ctx->n_switch + 1);
+    if (target) {
+        qatomic_set(&ctx->n_hit, ctx->n_hit + 1);
+    } else {
+        /* Recycle a slot: empty its tables and its jump cache. */
+        target = victim;
+        target->valid = false;
+        for (work = target->dirty; work != 0; work &= work - 1) {
+            tlb_mmu_flush_locked(&target->d[ctz32(work)], &target->f[ctz32(work)]);
+        }
+        target->dirty = 0;
+        target->tag = 0;
+        {
+            CPUJumpCache *jc = ctx->jc[target->jc];
+
+            qatomic_set(&ctx->jc_used[target->jc], false);
+            for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+                qatomic_set(&jc->array[i].tb, NULL);
+            }
+            qatomic_set(&ctx->jc_used[target->jc], true);
+        }
+    }
+
+    /* Exchange the live set with the slot. An mmu index that is clean on both sides has nothing to move. */
+    for (work = tlb->c.dirty | target->dirty; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDesc td;
+        CPUTLBDescFast tf;
+
+        if (!target->f[mmu_idx].table) {
+            tlb_mmu_init(&target->d[mmu_idx], &target->f[mmu_idx], now);
+        }
+        /* NB: the live CPUTLBDescFast array is stored in reverse order, see cpu_tlb_fast() */
+        td = tlb->d[mmu_idx];
+        tf = *cpu_tlb_fast(cpu, mmu_idx);
+        tlb->d[mmu_idx] = target->d[mmu_idx];
+        *cpu_tlb_fast(cpu, mmu_idx) = target->f[mmu_idx];
+        target->d[mmu_idx] = td;
+        target->f[mmu_idx] = tf;
+    }
+    work = tlb->c.dirty;
+    tlb->c.dirty = target->dirty;
+    target->dirty = work;
+
+    {
+        uint64_t tag = ctx->live_tag;
+        ctx->live_tag = target->tag;
+        target->tag = tag;
+    }
+    j = target->jc;
+    target->jc = ctx->live_jc;
+    ctx->live_jc = j;
+    qatomic_set(&cpu->tb_jmp_cache, ctx->jc[j]);
+
+    target->id = old_id;
+    target->valid = true;
+    target->last_use = ++ctx->tick;
+
+    qemu_spin_unlock(&tlb->c.lock);
+}
