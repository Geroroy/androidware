+/* Lazily create the context store of @cpu (vCPU thread). */
+static struct CPUTLBContexts *tlb_ctx_get(CPUState *cpu)
+{
+    struct CPUTLBContexts *ctx = cpu->tlb_ctx;
+
+    if (unlikely(!ctx)) {
+        ctx = g_new0(struct CPUTLBContexts, 1);
+        ctx->jc[0] = cpu->tb_jmp_cache;
+        ctx->jc_used[0] = true;
+        ctx->live_jc = 0;
+        for (int s = 0; s < TLB_CTX_SLOTS; s++) {
+            ctx->jc[s + 1] = g_new0(CPUJumpCache, 1);
+            ctx->slot[s].jc = s + 1;
+        }
+        qemu_spin_lock(&cpu->neg.tlb.c.lock);
+        qatomic_set(&cpu->tlb_ctx, ctx);
+        qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    }
+    return ctx;
