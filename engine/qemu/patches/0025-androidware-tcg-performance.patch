+#else
+/*
+ * androidware: self-check for the saved TLB contexts (AW_TLB_CTX=verify in
+ * the environment). After the guest has installed an address space, every
+ * entry of the live TLB is compared with a fresh page table walk. A
+ * mismatch means an entry outlived the guest's invalidation.
+ */
+static int arm_tlb_selfcheck_mode(void)
+{
+    static int mode = -1;
+
+    if (unlikely(mode < 0)) {
+        const char *e = getenv("AW_TLB_CTX");
+        mode = e && !strcmp(e, "verify");
+    }
+    return mode;
+}
+
+/*
+ * A mismatch is not necessarily an error: Linux clears page table entries
+ * first and invalidates the TLB a little later (munmap/madvise batches, fork
+ * write-protection, lazily freed vmalloc areas), and another CPU's
+ * invalidation may still be queued for this one. Such an entry is gone the
+ * next time we look. Only a mismatch that is still there SELFCHECK_PERSIST_NS
+ * later, outside the lazily flushed vmalloc range, is reported as an error.
+ */
+#define SELFCHECK_SUSPECTS 8192
+#define SELFCHECK_PERSIST_NS (300 * 1000 * 1000LL)
+typedef struct {
+    bool used;
+    int cpu, mmu_idx, access;
+    uint32_t asid;
+    vaddr page;
+    int64_t first_seen;
+    unsigned long round;
+    bool counted_lazy;
+} ARMTLBSuspect;
+static ARMTLBSuspect selfcheck_suspects[SELFCHECK_SUSPECTS];
+/* guest invalidations seen (any CPU), to tell "QEMU missed it" from "the guest never asked" */
+static QemuMutex selfcheck_lock;
+static unsigned long selfcheck_checked, selfcheck_transient, selfcheck_pending, selfcheck_persistent, selfcheck_rounds;
+static struct { vaddr page; int asid; int64_t ns; } selfcheck_page_flush[65536];
+static int64_t selfcheck_asid_flush[256], selfcheck_all_flush;
+
+static unsigned selfcheck_page_hash(vaddr page, int asid)
+{
+    return ((page >> 12) ^ (asid * 0x9e5)) & 0xffff;
+}
+
+/* kind 0: page, value = va | asid (asid < 0: every asid); 1: asid; 2: all */
+void arm_tlb_selfcheck_note(int kind, uint64_t value)
+{
+    int64_t now;
+
+    if (likely(!arm_tlb_selfcheck_mode())) {
+        return;
+    }
+    now = get_clock_realtime();
+    if (kind == 0 || kind == 3) {
+        vaddr page = value & ~0xfffull;
+        if (kind == 3) {            /* all ASIDs: note it for each */
+            for (int a = 0; a < 256; a++) {
+                unsigned h = selfcheck_page_hash(page, a);
+                selfcheck_page_flush[h].page = page;
+                selfcheck_page_flush[h].asid = a;
+                selfcheck_page_flush[h].ns = now;
+            }
+        } else {
+            unsigned h = selfcheck_page_hash(page, value & 0xff);
+            selfcheck_page_flush[h].page = page;
+            selfcheck_page_flush[h].asid = value & 0xff;
+            selfcheck_page_flush[h].ns = now;
+        }
+    } else if (kind == 1) {
+        selfcheck_asid_flush[value & 0xff] = now;
+    } else {
+        selfcheck_all_flush = now;
+    }
+}
+
+/* Latest guest invalidation that covers (@asid, @page), 0 if none is remembered. */
+static int64_t selfcheck_covered(vaddr page, int asid)
+{
+    unsigned h = selfcheck_page_hash(page, asid);
+    int64_t t = MAX(selfcheck_asid_flush[asid], selfcheck_all_flush);
+
+    if (selfcheck_page_flush[h].page == page && selfcheck_page_flush[h].asid == asid) {
+        t = MAX(t, selfcheck_page_flush[h].ns);
+    }
+    return t;
+}
+
+typedef struct {
+    CPUARMState *env;
+    const char *why;
+    uint32_t asid;
+    unsigned long round;
+    int64_t now;
+    unsigned checked;
+} ARMTLBSelfcheck;
+
+static void arm_tlb_selfcheck_entry(CPUState *cs, int mmu_idx, vaddr page, bool r, bool w, bool x,
+                                    hwaddr phys, void *opaque)
+{
+    static const MMUAccessType types[3] = { MMU_DATA_LOAD, MMU_DATA_STORE, MMU_INST_FETCH };
+    ARMTLBSelfcheck *c = opaque;
+    bool want[3] = { r, w, x };
+
+    for (int t = 0; t < 3; t++) {
+        GetPhysAddrResult res = {};
+        ARMMMUFaultInfo fi = {};
+        ARMTLBSuspect *sp = NULL, *free_sp = NULL;
+
+        if (!want[t]) {
+            continue;
+        }
+        c->checked++;
+        /* get_phys_addr() returns true on success */
+        if (get_phys_addr(c->env, page, types[t], 0, core_to_arm_mmu_idx(c->env, mmu_idx), &res, &fi)
+            && (res.f.phys_addr & (hwaddr)(int64_t)qemu_target_page_mask()) == phys) {
+            continue;
+        }
+        for (int i = 0; i < SELFCHECK_SUSPECTS; i++) {
+            ARMTLBSuspect *q = &selfcheck_suspects[i];
+            if (!q->used) {
+                free_sp = free_sp ? free_sp : q;
+            } else if (q->cpu == cs->cpu_index && q->asid == c->asid && q->mmu_idx == mmu_idx &&
+                       q->access == t && q->page == page) {
+                sp = q;
+                break;
+            }
+        }
+        if (!sp) {
+            selfcheck_transient++;
+            if (free_sp) {
+                *free_sp = (ARMTLBSuspect){ .used = true, .cpu = cs->cpu_index, .mmu_idx = mmu_idx, .access = t,
+                                            .asid = c->asid, .page = page, .first_seen = c->now, .round = c->round };
+            }
+            continue;
+        }
+        sp->round = c->round;
+        if (sp->first_seen < 0) {
+            continue;       /* already reported */
+        }
+        {
+            /*
+             * The decisive test: the guest invalidated this page (or its
+             * address space, or everything) after we first saw the
+             * mismatch, the invalidation has had ample time to be processed
+             * on this CPU, and the entry is still here.
+             */
+            int64_t cov = selfcheck_covered(page, c->asid);
+            bool kernel_va = page >= 0xc0000000u;
+
+            if (kernel_va) {
+                /* global mapping: any ASID in the invalidation matches */
+                for (int a = 0; a < 256; a++) {
+                    unsigned h = selfcheck_page_hash(page, a);
+                    if (selfcheck_page_flush[h].page == page && selfcheck_page_flush[h].asid == a) {
+                        cov = MAX(cov, selfcheck_page_flush[h].ns);
+                    }
+                }
+            }
+            if (cov > sp->first_seen && c->now - cov > 100 * 1000 * 1000LL) {
+                selfcheck_persistent++;
+                error_report("androidware: STALE TLB entry SURVIVED INVALIDATION: cpu %d mmu_idx %d va 0x%" VADDR_PRIx
+                             " access %d cached pa 0x%" HWADDR_PRIx " walk %s 0x%" HWADDR_PRIx
+                             " (contextidr 0x%x ttbr0 0x%" PRIx64 ") first mismatch %" PRId64 " ms ago,"
+                             " invalidated %" PRId64 " ms ago",
+                             cs->cpu_index, mmu_idx, page, t, phys,
+                             fi.type != ARMFault_None ? "FAULT" : "pa",
+                             (hwaddr)(res.f.phys_addr & (hwaddr)(int64_t)qemu_target_page_mask()),
+                             (unsigned)c->env->cp15.contextidr_el[1], (uint64_t)c->env->cp15.ttbr0_ns,
+                             (c->now - sp->first_seen) / 1000000, (c->now - cov) / 1000000);
+                sp->first_seen = -1;
+            } else if (c->now - sp->first_seen > SELFCHECK_PERSIST_NS && !sp->counted_lazy) {
+                /* cleared by the guest but not (yet) invalidated: process teardown, lazily freed vmalloc areas */
+                sp->counted_lazy = true;
+                selfcheck_pending++;
+            }
+        }
+    }
+}
+
+void arm_tlb_contexts_selfcheck(CPUARMState *env, const char *why)
+{
+    static bool inited;
+    ARMTLBSelfcheck c = { .env = env, .why = why };
+    CPUState *cs = env_cpu(env);
+
+    if (likely(!arm_tlb_selfcheck_mode()) || !arm_tlb_contexts_ok(env) ||
+        extended_addresses_enabled(env) ||
+        env->cp15.ttbr0_ns == env->cp15.ttbr1_ns) {
+        /* TTBR0 == TTBR1: Linux is in the middle of a switch, no user mappings */
+        return;
+    }
+    if (!qatomic_xchg(&inited, true)) {
+        qemu_mutex_init(&selfcheck_lock);
+    }
+    qemu_mutex_lock(&selfcheck_lock);
+    c.asid = env->cp15.contextidr_el[1] & 0xff;
+    c.round = ++selfcheck_rounds;
+    c.now = get_clock_realtime();
+    tlb_visit_entries(cs, arm_tlb_selfcheck_entry, &c);
+    selfcheck_checked += c.checked;
+    /* suspects of this cpu and address space that were not seen again are resolved */
+    for (int i = 0; i < SELFCHECK_SUSPECTS; i++) {
+        ARMTLBSuspect *q = &selfcheck_suspects[i];
+        if (q->used && q->cpu == cs->cpu_index && q->asid == c.asid && q->round != c.round) {
+            q->used = false;
+        }
+    }
+    if ((selfcheck_rounds & 0x3fff) == 0) {
+        error_report("androidware: TLB self-check: %lu rounds, %lu entries checked, %lu transient mismatches, "
+                     "%lu not yet invalidated by the guest after 300 ms, %lu SURVIVED AN INVALIDATION", selfcheck_rounds, selfcheck_checked,
+                     selfcheck_transient, selfcheck_pending, selfcheck_persistent);
+    }
+    qemu_mutex_unlock(&selfcheck_lock);
+}
