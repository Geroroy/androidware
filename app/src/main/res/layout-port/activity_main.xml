<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Guest display (VNC framebuffer). Touch events become guest pointer events. -->
    <FrameLayout
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#000000">
        <!-- Host-GPU mode: the GLES renderer draws the guest screen here; VncView on top only takes touches. -->
        <SurfaceView
            android:id="@+id/gl_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />
        <dev.androidware.app.VncView
            android:id="@+id/vnc"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="#202020">

        <!-- 3-column grid so every button is visible without scrolling -->
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3">
            <Button android:id="@+id/btn_host" android:text="@string/btn_host_info" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_selftest" android:text="@string/btn_selftest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_boottest" android:text="@string/btn_boottest" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_export" android:text="@string/btn_export_log" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_kernel" android:text="@string/btn_import_kernel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_initrd" android:text="@string/btn_import_initrd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_disk" android:text="@string/btn_import_disk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_apk" android:text="@string/btn_inspect_apk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_start" android:text="@string/btn_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_stop" android:text="@string/btn_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_android_get" android:text="@string/btn_android_get" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_android_start" android:text="@string/btn_android_start" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
            <Button android:id="@+id/btn_fullscreen" android:text="@string/btn_fullscreen" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:textSize="11sp" android:textAllCaps="false" android:minHeight="40dp" />
        </GridLayout>

        <ScrollView android:id="@+id/log_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:typeface="monospace" android:textSize="10sp" android:textColor="#C0FFC0" android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
